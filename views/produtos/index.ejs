<%- include("../partials/header") %>
    <%- include("../partials/nav") %>
        <div class="container mt-5">

            <div class="d-flex justify-content-between
                align-items-center mb-4">
                <div>
                    <h1>Produtos</h1>
                    <p class="text-muted">
                         produtos cadastrados
                    </p>
                </div>
                <a href="/produtos/cadastro" class="btn btn-primary">
                    + Novo Produto
                </a>
            </div>


            <div class="card shadow-sm">
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle">
                            <thead class="table-dark">
                                <tr>
                                    <th>ID</th>
                                    <th>Nome</th>
                                    <th>Preço</th>
                                    <th>Estoque</th>
                                    <th>Categoria</th>
                                    <th>Descrição</th>
                                    <th>Opções</th>

                                </tr>
                            </thead>
                            <tbody>
                                <% produtos.forEach(mostrar=> { %>
                                   <tr>
        <td><%= mostrar.id %></td>
        <td><%= mostrar.nome %></td>
        <td><%= mostrar.preco %></td>
        <td><%= mostrar.estoque %></td>
        <td><%= mostrar.categoria %></td>
        <td><%= mostrar.descricao %></td>

        <td>
            <a class="btn btn-success btn-sm"
               href="/produtos/editar/<%= mostrar.id %>">
                Editar
            </a>

            <a class="btn btn-danger btn-sm"
               href="/produtos/excluir/<%= mostrar.id %>"
               onclick="return confirm('Deseja excluir este produto?')">
                Excluir
            </a>
        </td>
    </tr>
<% }) %>
                                    </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

        </div>

        <%- include("../partials/footer") %>